<% content_for :title, "Reset password — OneKare" %>
<div style="text-align:center;margin-top:40px"><%= link_to root_path, class: "brand", style: "display:inline-flex;align-items:center;gap:10px;font-family:var(--serif);font-size:1.3rem;text-decoration:none;color:var(--ink)" do %><span class="logo-mark" style="margin:0;background:var(--sidebar);color:#fff;width:36px;height:36px;font-size:1.05rem">O</span> OneKare<% end %></div>
<div class="auth-card" style="margin-top:24px">
  <h1>Forgot your password?</h1>
  <p class="muted small" style="margin-top:-8px">Enter your email and we’ll send reset instructions.</p>
  <%= form_with url: passwords_path do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email address" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>
    <%= form.submit "Send reset link", style: "width:100%" %>
  <% end %>
  <p class="small" style="margin:18px 0 0;text-align:center"><%= link_to "Back to log in", login_path %></p>
</div>
