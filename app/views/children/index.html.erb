<% content_for :title, "Children — OneKare" %>
<div class="page-head">
  <div><h1>Children</h1><p>Reusable profiles you can use for any daycare application.</p></div>
  <%= link_to "Add a child", new_child_path, class: "btn btn-primary" %>
</div>
<% if @children.any? %>
  <div class="tile-grid">
    <% @children.each do |child| %>
      <li>
        <%= child.full_name %> — <%= child.date_of_birth&.to_fs(:long) || child.expected_due_date&.to_fs(:long) || "Birthdate unknown" %>
        <%= link_to "Edit", edit_child_path(child) %>
      </li>
    <% end %>
  </div>
<% else %>
  <div class="empty">
    <h3 style="margin-bottom:6px">No child profiles yet</h3>
    <p style="margin:0 0 16px">Add your child once and reuse their profile for every application.</p>
    <%= link_to "Add a child", new_child_path, class: "btn btn-primary" %>
  </div>
<% end %>
