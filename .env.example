# Copy to .env.development.local. Never put real credentials in this template.
# Uncomment DATABASE_URL after replacing it with your Lakebase development URL.
# Preserve the SSL options supplied by Lakebase and URL-encode credentials as needed.
# DATABASE_URL='postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require'

# Required when live form mapping needs a fresh Databricks suggestion:
# DATABRICKS_HOST='https://your-workspace-host'
# DATABRICKS_TOKEN='your-token'
# DATABRICKS_MODEL_ENDPOINT='your-model-endpoint'

# Gmail OAuth for local Parkcrest test sends. Put real values only in the ignored
# .env.development.local file. The test recipient must never be Parkcrest.
# GOOGLE_OAUTH_CLIENT_ID='your-web-application-client-id'
# GOOGLE_OAUTH_CLIENT_SECRET='your-web-application-client-secret'
# PARKCREST_TEST_RECIPIENT='an-address-you-control@example.com'
