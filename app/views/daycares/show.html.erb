<% content_for :title, "#{@daycare.name} — OneKare" %>
<% child = params[:child_id].present? ? onekare_user.children.find_by(id: params[:child_id]) : nil %>
<%= link_to "← Back to search", daycares_path(child_id: params[:child_id]), class: "back-link" %>
<div class="page-head">
  <div>
    <h1><%= @daycare.name %></h1>
    <p><%= [ @daycare.address, @daycare.city, @daycare.postal_code ].compact_blank.join(", ") %></p>
  </div>
</div>

<div class="detail-layout">
  <div>
    <div class="card">
      <h2 style="margin-bottom:12px">Care types</h2>
      <% if @daycare.care_types.any? %>
        <div style="display:flex;gap:6px;flex-wrap:wrap">
          <% @daycare.care_types.each do |care_type| %><span class="badge review"><%= care_type["label"] %></span><% end %>
        </div>
      <% else %>
        <p class="muted" style="margin:0">No care types reported.</p>
      <% end %>
    </div>

    <div class="card">
      <h2 style="margin-bottom:12px">Reported vacancies</h2>
      <% available_vacancies = @daycare.reported_vacancies.values.select { |vacancy| vacancy["available"] } %>
      <% if available_vacancies.any? %>
        <ul style="margin:0;padding-left:20px"><% available_vacancies.each do |vacancy| %><li><%= vacancy["label"] %></li><% end %></ul>
      <% else %>
        <p class="muted" style="margin:0">No vacancies reported.</p>
      <% end %>
      <% if @daycare.vacancy_updated_at.present? %>
        <p class="muted small" style="margin:10px 0 0">Vacancy information updated <%= @daycare.vacancy_updated_at.to_date.to_fs(:long) %>.</p>
      <% end %>
    </div>
  </div>

  <aside>
    <div class="card">
      <h3 style="margin-bottom:12px">Contact</h3>
      <dl class="kv" style="grid-template-columns: 70px 1fr">
        <dt>Phone</dt><dd><%= @daycare.phone.present? ? link_to(@daycare.phone, "tel:#{@daycare.phone}") : "Not provided" %></dd>
        <dt>Email</dt><dd><%= @daycare.contact_email.present? ? mail_to(@daycare.contact_email) : "Not provided" %></dd>
        <% if @daycare.website_link_url.present? %>
          <dt>Website</dt><dd><%= link_to "Visit website", @daycare.website_link_url, target: "_blank", rel: "noopener" %></dd>
        <% end %>
      </dl>
    </div>

    <div class="card">
      <h3 style="margin-bottom:12px">Apply</h3>
      <% if @daycare.support_status == "unconfigured" %>
        <% if @daycare.website_link_url.present? %>
          <%= link_to "Visit daycare website", @daycare.website_link_url, target: "_blank", rel: "noopener", class: "btn btn-outline" %>
        <% elsif @daycare.contact_email.present? %>
          <%= mail_to @daycare.contact_email, "Email this daycare", class: "btn btn-outline" %>
        <% elsif @daycare.phone.present? %>
          <%= link_to "Call this daycare", "tel:#{@daycare.phone}", class: "btn btn-outline" %>
        <% else %>
          <p class="muted small" style="margin:0">This daycare has not provided a website or contact method.</p>
        <% end %>
      <% elsif @daycare.application_link_url.present? %>
        <%= link_to "Open verified application page", @daycare.application_link_url, target: "_blank", rel: "noopener", class: "btn btn-outline" %>
      <% end %>

      <div style="margin-top:12px">
        <button type="button" class="btn btn-primary" disabled style="opacity:.55;cursor:not-allowed">
          Apply with OneKare<%= child ? " for #{child.full_name.split.first}" : "" %>
        </button>
        <p class="muted small" style="margin:8px 0 0">One-click applications are coming soon.</p>
      </div>
    </div>
  </aside>
</div>
