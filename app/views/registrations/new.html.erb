<% content_for :title, "Sign up — OneKare" %>
<div style="text-align:center;margin-top:40px"><%= link_to root_path, class: "brand", style: "display:inline-flex;align-items:center;gap:10px;font-family:var(--serif);font-size:1.3rem;text-decoration:none;color:var(--ink)" do %><%= image_tag "onekare-tree-dark.png", alt: "", class: "brand-tree" %> OneKare<% end %></div>
<div class="auth-card" style="margin-top:24px">
  <h1>Create your account</h1>
  <% if @user.errors.any? %>
    <div class="flash alert" role="alert"><%= @user.errors.full_messages.to_sentence %></div>
  <% end %>
  <%= form_with model: @user, url: registrations_path do |form| %>
    <div class="field">
      <%= form.label :full_name, "Full name" %>
      <%= form.text_field :full_name, required: true, autofocus: true, autocomplete: "name", maxlength: 100 %>
    </div>
    <div class="field">
      <%= form.label :email_address, "Email address" %>
      <%= form.email_field :email_address, required: true, autocomplete: "email" %>
    </div>
    <div class="field">
      <%= form.label :phone_number, "Phone number" %>
      <%= form.telephone_field :phone_number, required: true, autocomplete: "tel", placeholder: "10-digit number" %>
    </div>
    <div class="field">
      <%= form.label :password, "Password" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72 %>
      <div class="hint">At least 12 characters.</div>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Confirm password" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <%= form.submit "Sign up", style: "width:100%" %>
  <% end %>
  <p class="small" style="margin:18px 0 0;text-align:center">Already have an account? <%= link_to "Log in", login_path %></p>
</div>
