<% content_for :title, "Search daycares — OneKare" %>
<div class="page-head"><div><h1>Search daycares</h1><p>Find licensed care near you for the child you choose.</p></div></div>

<div class="form-layout" style="grid-template-columns: 300px 1fr">
  <%= form_with url: search_path, method: :get, class: "card", data: { turbo_frame: "_top" } do %>
    <div class="field">
      <label for="child">Searching for</label>
      <%= select_tag :child, options_for_select(@children.map { |c| [ c.full_name, c.id ] } + [ [ "+ Add a child", "new" ] ], params[:child]), id: "child" %>
    </div>
    <div class="field">
      <label for="location">Location</label>
      <%= text_field_tag :location, params[:location], id: "location", placeholder: "Postal code or neighbourhood" %>
    </div>
    <div class="field">
      <label for="distance">Distance</label>
      <%= select_tag :distance, options_for_select([ "2 km", "5 km", "10 km", "25 km" ], params[:distance] || "5 km"), id: "distance" %>
    </div>
    <div class="field">
      <span class="label">Type of care</span>
      <div class="choices"><% ProfileSchema::PROGRAMS.each do |p| %>
        <label><%= check_box_tag "program[]", p, Array(params[:program]).include?(p) %> <%= p %></label>
      <% end %></div>
    </div>
    <div class="field">
      <span class="label">Schedule</span>
      <div class="choices"><% ProfileSchema::SCHEDULES.each do |s| %>
        <label><%= check_box_tag "schedule[]", s, Array(params[:schedule]).include?(s) %> <%= s %></label>
      <% end %></div>
    </div>
    <div class="field">
      <label for="start">Earliest start date</label>
      <%= date_field_tag :start, params[:start], id: "start" %>
    </div>
    <div class="field">
      <label for="language">Language</label>
      <%= text_field_tag :language, params[:language], id: "language", placeholder: "e.g. Mandarin, French" %>
    </div>
    <div class="field">
      <span class="label">Other</span>
      <div class="choices">
        <label><%= check_box_tag :accepting, "1", params[:accepting] %> Accepting waitlist requests</label>
        <label><%= check_box_tag :supports, "1", params[:supports] %> Extra-support programs</label>
      </div>
    </div>
    <%= submit_tag "Search", class: "btn btn-primary", style: "width:100%" %>
  <% end %>

  <div>
    <div class="empty">
      <h3 style="margin-bottom:6px"><%= @searched ? "No results to show yet" : "Your results will appear here" %></h3>
      <p style="margin:0">Daycare search is coming soon. Choose a child and set your filters to be ready.</p>
    </div>
  </div>
</div>
