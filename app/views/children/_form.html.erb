<div class="card" style="max-width:520px">
  <% if child.errors.any? %>
    <div class="flash alert" role="alert"><%= child.errors.full_messages.to_sentence %></div>
  <% end %>
  <%= form_with model: child do |form| %>
    <div class="field">
      <%= form.label :first_name, "First name" %>
      <%= form.text_field :first_name, required: true, autofocus: true, autocomplete: "given-name", maxlength: 100 %>
    </div>
    <div class="field">
      <%= form.label :last_name, "Last name" %>
      <%= form.text_field :last_name, required: true, autocomplete: "family-name", maxlength: 100 %>
    </div>
    <div class="field">
      <%= form.label :date_of_birth, "Date of birth" %>
      <%= form.date_field :date_of_birth, required: true %>
    </div>
    <div class="btn-row" style="margin-top:8px">
      <%= form.submit (child.persisted? ? "Save changes" : "Add child"), class: "btn btn-primary" %>
      <%= link_to "Cancel", children_path, class: "btn btn-link" %>
    </div>
  <% end %>
</div>
