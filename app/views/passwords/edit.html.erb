<% content_for :title, "Choose a new password — OneKare" %>
<div style="text-align:center;margin-top:40px"><%= link_to root_path, class: "brand", style: "display:inline-flex;align-items:center;gap:10px;font-family:var(--serif);font-size:1.3rem;text-decoration:none;color:var(--ink)" do %><span class="logo-mark" style="margin:0;background:var(--sidebar);color:#fff;width:36px;height:36px;font-size:1.05rem">O</span> OneKare<% end %></div>
<div class="auth-card" style="margin-top:24px">
  <h1>Choose a new password</h1>
  <%= form_with url: password_path(params[:token]), method: :put do |form| %>
    <div class="field">
      <%= form.label :password, "New password" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", minlength: 12, maxlength: 72 %>
      <div class="hint">At least 12 characters.</div>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Confirm new password" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <%= form.submit "Save password", style: "width:100%" %>
  <% end %>
</div>
