<% content_for :title, "OneKare — one profile, every daycare application" %>
<header class="public-nav">
  <%= link_to root_path, class: "brand" do %><span class="logo-mark">O</span> OneKare<% end %>
  <div style="display:flex;gap:12px">
    <%= link_to "Log in", login_target, class: "btn btn-outline" %>
    <%= link_to "Sign up", signup_target, class: "btn btn-primary" %>
  </div>
</header>

<section class="hero">
  <h1>One profile. Every daycare application.</h1>
  <p>Tell us about your child once. OneKare finds nearby daycares and prepares each application for you to review and approve.</p>
  <div class="btn-row">
    <%= link_to "Sign up", signup_target, class: "btn btn-primary btn-lg" %>
    <%= link_to "Log in", login_target, class: "btn btn-outline btn-lg" %>
  </div>
</section>

<section class="steps">
  <div class="step-card"><div class="num">1</div><h3>Build a profile</h3><p>Answer the questions daycares ask, at your own pace. Save and come back anytime.</p></div>
  <div class="step-card"><div class="num">2</div><h3>Find nearby care</h3><p>Search local daycares and filter by age group, schedule and location.</p></div>
  <div class="step-card"><div class="num">3</div><h3>Review and apply</h3><p>See exactly what will be sent to each daycare. Nothing is submitted without your approval.</p></div>
</section>
